    { "id": "ascon", "type": "security", "label": "Ascon-128", "sublabel": "cipher_ascon.py" },
    { "id": "aesgcm", "type": "security", "label": "AES-GCM", "sublabel": "cipher_aes.py" },
    { "id": "verify", "type": "security", "label": "Tag Verify", "sublabel": "auth tag check" }
  ],
  "segments": [
    { "from": 160, "to": 195, "label": "Trigger" },
