    { "id": "verify-result", "from": "verify", "to": "aead", "y": 445, "label": "valid / invalid", "variant": "return" },
    { "id": "open-return", "from": "aead", "to": "bench", "y": 475, "label": "plaintext or None", "variant": "return" },
    { "id": "results-return", "from": "bench", "to": "ui", "y": 505, "label": "update charts + table", "variant": "return", "note": "records timing + pass/fail before reporting" }
