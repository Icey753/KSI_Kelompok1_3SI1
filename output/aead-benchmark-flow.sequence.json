    { "participant": "aesgcm", "from": 285, "to": 325, "type": "security" },
    { "participant": "verify", "from": 410, "to": 450, "type": "security" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Seal Path",
      "items": [
        "One wrapper call routes to either Ascon-128 or AES-GCM",
